    - rid: 5406076879839166571
      type: {class: Event_Dialogue, ns: Tuto, asm: Assembly-CSharp}
      data:
        _dialogue: "Une exp\xE9rience rat\xE9e a cr\xE9\xE9e un virus cristallin
