        _keyVoceline: MissionBriefing-2
        _duration: 3
        speaker: 0
    - rid: 5406076879839166572
      type: {class: Event_Dialogue, ns: Tuto, asm: Assembly-CSharp}
      data:
        _dialogue: "Vous \xEAtes charg\xE9s de purifier les nids de l'infection,
          et d'\xE9liminer les cr\xE9atures contamin\xE9es."
        _keyVoceline: MissionBriefing-3
        _duration: 3
        speaker: 0
    - rid: 5406076879839166573
      type: {class: Event_Dialogue, ns: Tuto, asm: Assembly-CSharp}
      data:
        _dialogue: "Ah ouai, rien que \xE7a... On a vriament le pire boulot du monde."
        _keyVoceline: MissionBriefing-4
        _duration: 3
        speaker: 0
    - rid: 5406076879839166574
      type: {class: Event_Dialogue, ns: Tuto, asm: Assembly-CSharp}
      data:
        _dialogue: "Ouai... j'aurais d\xFB \xE9couter ma m\xE8re et... devenir toaster
