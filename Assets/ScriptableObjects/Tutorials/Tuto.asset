        _keyVoceline: MissionBriefing-55
        _duration: 3
        speaker: 1
    - rid: 5406076879839166575
      type: {class: Event_Dialogue, ns: Tuto, asm: Assembly-CSharp}
      data:
        _dialogue: "Ouverture de la porte. . . Pr\xE9parez-vous au conflit."
        _keyVoceline: MissionBriefing-6
        _duration: 3
        speaker: 2
    - rid: 5406076879839166576
      type: {class: Event_Dialogue, ns: Tuto, asm: Assembly-CSharp}
      data:
        _dialogue: "Tu sais pourquoi on doit se taper tout le protocole de v\xE9rification
          \xE0 chaque fois ?"
