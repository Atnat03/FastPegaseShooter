    - rid: 5406076879839166577
      type: {class: Event_Dialogue, ns: Tuto, asm: Assembly-CSharp}
      data:
        _dialogue: "L'\xE9nergie que vous g\xE9n\xE9rer ne vous est pas utile. Par
