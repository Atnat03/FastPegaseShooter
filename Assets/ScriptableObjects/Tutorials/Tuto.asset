    - rid: 5406076879839166585
      type: {class: Event_Dialogue, ns: Tuto, asm: Assembly-CSharp}
      data:
        _dialogue: "Ils se sentent toujours oblig\xE9s d'utiliser des mots compliqu\xE9s
