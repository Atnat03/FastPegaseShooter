  lines:
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: 9fc97a487983a9d47b9f07491e2a6e36, type: 3}
    text: 'Mais comment t''as fais pour mourir ? '
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 1
    listener: 0
    audioClip: {fileID: 8300000, guid: 212da93236867ff49a45c1978bfc89b3, type: 3}
    text: "Atatatata, j'suis pas mort ! Y'a juste une mise \xE0 jour."
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: 7cd908e8932a47044bf759edba22bf32, type: 3}
    text: "Tu sais que je suis au courant quand on a des mises \xE0 jours ?"
    DelayBeforeNextLine: 0
    volume: 0.6
