  lines:
  - speaker: 1
    listener: 0
    audioClip: {fileID: 8300000, guid: 7e94d3cc7d0fc68458d815aa8de1c398, type: 3}
    text: T'es mort ?
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: 80e06e669b106e543a826ebaee3c91f7, type: 3}
    text: "Nan nan ! J'fais juste une pause l\xE0, j'arrive."
    DelayBeforeNextLine: 0
    volume: 1
  - speaker: 1
    listener: 0
    audioClip: {fileID: 8300000, guid: 958db43aa4ae6554782fd65147bcf5c8, type: 3}
    text: "Eh t'abuses, j'suis en gal\xE8re l\xE0."
    DelayBeforeNextLine: 0
    volume: 0.6
