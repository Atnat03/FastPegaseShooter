  m_Script: {fileID: 11500000, guid: e690c891e4a72a04a952749de7e54765, type: 3}
  m_Name: Start Arena2
  m_EditorClassIdentifier: Assembly-CSharp::DialoguesDataSO
  lines:
  - speaker: 1
    listener: 0
    audioClip: {fileID: 8300000, guid: 9a1e06b4222b1f347ad15db968f77a5a, type: 3}
    text: "Ah ouai, sacr\xE9 complexe quand m\xEAme..."
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: 8f87da2f604a2a24facb786615cce50c, type: 3}
    text: "Mais quel genre de trucs tu dois monter pour avoir un ascenceur comme
      \xE7a ?"
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 1
    listener: 0
    audioClip: {fileID: 8300000, guid: 44c6422ff5f8dfb4daeb067e6d816200, type: 3}
    text: "Et, qu'est ce qu'on fait maintenant ? On va quand m\xEAme pas escalader
      ?"
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 0
    listener: 0
    audioClip: {fileID: 8300000, guid: 44c6422ff5f8dfb4daeb067e6d816200, type: 3}
    text: Activation de la plateforme. . .
    DelayBeforeNextLine: 0
    volume: 2
  - speaker: 1
    listener: 0
    audioClip: {fileID: 8300000, guid: 82c8a357de25e804cb528df379746957, type: 3}
    text: "Ok, \xE7a va."
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: a5c79997a5bcb17479663385d60cfcbd, type: 3}
    text: Pour une fois que je suis content de l'entendre parler.
    DelayBeforeNextLine: 0
    volume: 0.6
