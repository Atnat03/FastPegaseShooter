    volume: 0.6
  - speaker: 0
    listener: 0
    audioClip: {fileID: 8300000, guid: def8d62fc8397804499383fa4ac49f89, type: 3}
    text: "Vous arrivez au coeur de l'infection, pr\xE9parez-vous !"
