  m_Script: {fileID: 11500000, guid: e690c891e4a72a04a952749de7e54765, type: 3}
  m_Name: End Arena 2
  m_EditorClassIdentifier: Assembly-CSharp::DialoguesDataSO
  lines:
  - speaker: 1
    listener: 0
    audioClip: {fileID: 8300000, guid: fe0ecbe4990eb3940821de92776344de, type: 3}
    text: "Et ouai mon gars ! \xC7a c'est la classe"
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: a1ebebcacae675f4f9a7e8effbd5c376, type: 3}
    text: "Oh ouai ! J'men lasse jamais de celle l\xE0 !"
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 0
    listener: 0
    audioClip: {fileID: 8300000, guid: 7c6cc8c950db7b1408cda32d39eebd63, type: 3}
    text: "Nid d 'infection n\xB02 purifi\xE9. Il en reste un dernier, ne perdez
      pas de temps."
    DelayBeforeNextLine: 0
    volume: 2
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: 8be6dc6fc120fde48b9ac3923a34dd69, type: 3}
    text: "M\xEAme pas le droit de se poser 2 secondes ?"
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 1
    listener: 0
    audioClip: {fileID: 8300000, guid: a12197cb69fe0b24cb8e793ca88f37d9, type: 3}
    text: "Bah ouai, c'est \xE7a le bas de l'\xE9chelle sociale..."
    DelayBeforeNextLine: 0
    volume: 0.6
