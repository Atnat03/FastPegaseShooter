%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e690c891e4a72a04a952749de7e54765, type: 3}
  m_Name: End Arena 3
  m_EditorClassIdentifier: Assembly-CSharp::DialoguesDataSO
  lines:
  - speaker: 0
    listener: 0
    audioClip: {fileID: 8300000, guid: 0946db131f0e88a4cb0789a3f6a10ef9, type: 3}
    text: "F\xE9licitations, vous venez de purifier le dernier nid de l'infection
      ! Votre travail est d\xE9sormais termin\xE9."
    DelayBeforeNextLine: 0
    volume: 2
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: 4ca794e41c2ab85418d5caa6de400552, type: 3}
    text: "Eh bah, on aura bien m\xE9rit\xE9 notre prime !"
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 0
    listener: 0
    audioClip: {fileID: 8300000, guid: 0580898ec9f9d1447ab9b8a1fe61acc6, type: 3}
    text: "Votre prime a \xE9t\xE9 utilis\xE9e pour compenser le crash de la capsule
      d'atterrissage."
    DelayBeforeNextLine: 0
    volume: 2
  - speaker: 1
    listener: 0
    audioClip: {fileID: 8300000, guid: ba36506209b0239489cf4d63c2610b1c, type: 3}
    text: Attends, c'est une blague ?
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: dd5b32c3b0186664286eea8036bec728, type: 3}
    text: "J'en peux plus de cette bo\xEEte"
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: b4b00bfcdaf08b148aaa2c3e3ba10d29, type: 3}
    text: "Vas-y tiens le coup, plus que 867 missions avant la retraite. On en a
      d\xE9j\xE0 fait la moiti\xE9 !"
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: ea41dc8eb45ebcf4ca28d00eec2ce023, type: 3}
    text: "Tu veux pas d\xE9misionner plut\xF4t ?"
    DelayBeforeNextLine: 0
    volume: 0.5
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: 7cc89841e6d86b14aa015fb49631a32d, type: 3}
    text: "Ouai... Apr\xE8s robot exterminateur, y'a pas beaucoup de reconversions
      possibles..."
    DelayBeforeNextLine: 0
    volume: 0.4
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: e018d42798d3e5c48b1f293e3a1d69dc, type: 3}
    text: "J'sais pas... J'pourrais peut-\xEAtre faire robot mixeur ? Je me suis
      toujours dit que je ferais un bon robot mixeur."
    DelayBeforeNextLine: 0
    volume: 0.3
  - speaker: 0
    listener: 0
    audioClip: {fileID: 8300000, guid: fb32632170559834e99d65c3509d7e37, type: 3}
    text: "Ouai, \xE7a m'\xE9tonnes pas du tout de toi \xE7a tu vois."
    DelayBeforeNextLine: 0
    volume: 0.15
