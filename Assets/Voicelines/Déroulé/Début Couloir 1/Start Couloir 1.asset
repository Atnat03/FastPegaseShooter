  m_Script: {fileID: 11500000, guid: e690c891e4a72a04a952749de7e54765, type: 3}
  m_Name: Start Couloir 1
  m_EditorClassIdentifier: Assembly-CSharp::DialoguesDataSO
  lines:
  - speaker: 0
    listener: 0
    audioClip: {fileID: 8300000, guid: 7047e1935b0502141b28e5c78112840d, type: 3}
    text: Le prochain nid d'infection se trouve au bout de ce tunnel de transport.
    DelayBeforeNextLine: 0
    volume: 2
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: 6bd838e4fdf961643a9aa2552b4f89a2, type: 3}
    text: On fait la course ?
    DelayBeforeNextLine: 0
    volume: 1.8
  - speaker: 1
    listener: 0
    audioClip: {fileID: 8300000, guid: eadb60d52acaa714b8d2b87816068c48, type: 3}
    text: "Ok vas-y, et le dernier il paie les d\xE9g\xE2ts du crash !"
    DelayBeforeNextLine: 0
    volume: 1.8
  - speaker: 2
    listener: 0
    audioClip: {fileID: 8300000, guid: 846f4b6a3a3c699489268af05ea08e60, type: 3}
    text: "Ah je te l'ai d\xE9j\xE0 dis, je paierai pas pour leur bo\xEEte de conserrve
      !"
    DelayBeforeNextLine: 0
    volume: 0.6
  - speaker: 1
    listener: 0
    audioClip: {fileID: 8300000, guid: 210571106f0afc640b4eaef0379a8c33, type: 3}
    text: "T'as qu'\xE0 par arriver dernier !"
    DelayBeforeNextLine: 0
    volume: 0.6
